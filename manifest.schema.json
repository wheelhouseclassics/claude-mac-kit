{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude-mac-kit manifest",
  "description": "The curated contract between the build machine's ~/.claude and the kit. GENERATED by scripts/build-manifest.js — do not hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "generator", "marketplaces", "plugins", "skills", "commands", "hooks", "mcp", "connectors", "deps", "brew", "vault", "deny", "copyDeny", "settingsDeny"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "minLength": 10 },
    "generator": { "type": "string", "const": "scripts/build-manifest.js" },
    "marketplaces": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "source"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source": { "type": "object", "required": ["source", "repo"], "additionalProperties": false,
            "properties": { "source": { "type": "string", "const": "github" }, "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" } } }
        } }
    },
    "plugins": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "marketplace"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+@[a-z0-9-]+$" },
          "name": { "type": "string" },
          "marketplace": { "type": "string" },
          "runtime": { "type": "string", "enum": ["bun", "node", "python"] },
          "note": { "type": "string" }
        } }
    },
    "skills": { "type": "array", "items": { "$ref": "#/definitions/kitItem" } },
    "commands": { "type": "array", "items": { "$ref": "#/definitions/kitItem" } },
    "hooks": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "event", "path", "install", "command", "timeout", "source", "mode", "sourceSha256"],
        "properties": {
          "name": { "type": "string" },
          "event": { "type": "string", "enum": ["UserPromptSubmit", "SessionStart", "SessionEnd", "Stop", "PreToolUse", "PostToolUse", "Notification", "SubagentStop"] },
          "path": { "type": "string", "pattern": "^kit/hooks/" },
          "install": { "type": "string", "pattern": "^~/" },
          "command": { "type": "string" },
          "timeout": { "type": "integer" },
          "statusMessage": { "type": "string" },
          "source": { "type": "string", "pattern": "^~/" },
          "mode": { "type": "string", "enum": ["mirror", "port"] },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "note": { "type": "string" }
        } }
    },
    "mcp": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "type", "url", "scope"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["http", "sse"] },
          "url": { "type": "string", "pattern": "^https://" },
          "scope": { "type": "string", "enum": ["user", "project", "local"] },
          "note": { "type": "string" }
        } }
    },
    "connectors": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "required", "reason"],
        "properties": { "name": { "type": "string" }, "required": { "type": "boolean" }, "reason": { "type": "string" }, "surfaces": { "type": "array", "items": { "type": "string" } } } }
    },
    "deps": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "kind", "for"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["pip", "npm", "brew", "brew-cask"] },
          "package": { "type": "string" },
          "for": { "type": "string" },
          "extra": { "type": "boolean" }
        } }
    },
    "brew": {
      "type": "object", "additionalProperties": false, "required": ["formulae", "casks", "extras"],
      "properties": {
        "formulae": { "type": "array", "items": { "type": "string" } },
        "casks": { "type": "array", "items": { "type": "string" } },
        "extras": { "type": "object", "additionalProperties": false, "required": ["formulae", "casks"],
          "properties": { "formulae": { "type": "array", "items": { "type": "string" } }, "casks": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "vault": {
      "type": "object", "additionalProperties": false, "required": ["root", "folders", "files"],
      "properties": {
        "root": { "type": "string", "const": "~/second-brain" },
        "folders": { "type": "array", "minItems": 8, "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "mode"],
          "properties": { "path": { "type": "string" }, "mode": { "type": "string", "enum": ["mirror", "authored"] }, "source": { "type": "string", "pattern": "^~/" }, "sourceSha256": { "type": "string" } } } }
      }
    },
    "deny": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "kind", "reason"],
        "properties": { "name": { "type": "string" }, "kind": { "type": "string", "enum": ["skill", "command", "hook", "agent", "mcp-server", "mcp", "plugin", "settings", "vault"] }, "reason": { "type": "string" }, "path": { "type": "string" } } }
    },
    "copyDeny": { "type": "array", "minItems": 10, "items": { "type": "string" } },
    "settingsDeny": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "kitItem": {
      "type": "object", "additionalProperties": false, "required": ["name", "path", "source", "mode", "sourceSha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^kit/" },
        "source": { "type": "string", "pattern": "^~/" },
        "mode": { "type": "string", "enum": ["mirror", "port"] },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "note": { "type": "string" }
      }
    }
  }
}
