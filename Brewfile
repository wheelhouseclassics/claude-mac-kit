# claude-mac-kit — core tools. Installed item-by-item by install.sh (per-item wall clock),
# then verified with: brew bundle check --file=~/.claude-kit/Brewfile
brew "git"
brew "gh"
brew "gitleaks"
brew "node@24"      # Node LTS; keg-only, so install.sh runs `brew link --overwrite --force node@24`
brew "bun"
brew "python@3.12"  # kit venv interpreter (markitdown[all] needs >= 3.10; the CLT python3 is 3.9)
brew "tmux"
brew "tailscale"    # open-source tailscaled (D9): Tailscale SSH + Funnel. NOT the GUI cask.
cask "claude"       # Claude Desktop
cask "obsidian"
